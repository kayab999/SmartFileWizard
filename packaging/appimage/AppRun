#!/usr/bin/env bash
# FileWizard AppImage AppRun
# Launches GUI by default, CLI when CLI args are detected.
# Works both as AppImage entrypoint and when called via symlinks.
set -euo pipefail
HERE="$(dirname "$(readlink -f "${0}")")"
# Allow Qt to run without display check fallback — wayland vs xcb
if [ -z "${QT_QPA_PLATFORM:-}" ]; then
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    export QT_QPA_PLATFORM="wayland;xcb"
  else
    export QT_QPA_PLATFORM="xcb"
  fi
fi

# Resolve the bundled python entrypoint.
# PyInstaller one-dir build places binary under usr/bin/FileWizard (unified)
BIN="$HERE/usr/bin/FileWizard"
# Fallback for alternative layouts (one-file or flat)
if [ ! -x "$BIN" ]; then BIN="$HERE/FileWizard"; fi
if [ ! -x "$BIN" ]; then BIN="$HERE/usr/bin/filewizard"; fi
if [ ! -x "$BIN" ]; then BIN="$HERE/usr/bin/filewizard-ui"; fi

# Pass through directly — Python entry_main.py dispatches CLI vs GUI.
exec "$BIN" "$@"
